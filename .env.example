# Telegram bot: owner chat only
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=123456789

# Enable Telegram channels and/or house chats after configuring a user session
TELEGRAM_USER_ENABLED=0
TELEGRAM_USER_API_ID=0
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_SESSION=
TELEGRAM_SOURCE_CHANNELS=@Perforum_jobs
TELEGRAM_SOURCE_FETCH_LIMIT=150
TELEGRAM_VACANCY_BANNED_WORDS=врач,водитель,агент,терапевт,диспетчер
TELEGRAM_HOUSE_CHATS=Дом 1=@house_chat_1;Дом 2=@house_chat_2
MAX_CHARS_PER_HOUSE_CHAT_BATCH=3000
# Optional independent daily group digest, e.g. @vakifbank_tr
TELEGRAM_GROUP_DIGEST_CHAT=
TELEGRAM_GROUP_DIGEST_TIME=21:00

# Required for enabled house chats or the daily group digest; vacancies do not use an LLM
# GROQ_API_KEY / OPENAI_API_KEY and OPENAI_BASE_URL / OPENAI_MODEL also work
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
SUMMARY_MAX_OUTPUT_TOKENS=220

# Vacancies run at 13:00 Moscow, group at its configured Moscow time; houses run manually
TZ=Europe/Moscow
LOG_LEVEL=INFO
