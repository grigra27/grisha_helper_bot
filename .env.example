# Telegram bot: owner chat only
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=123456789

# Enable Telegram channels and/or house chats after configuring a user session
TELEGRAM_USER_ENABLED=0
TELEGRAM_USER_API_ID=0
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_SESSION=
TELEGRAM_SOURCE_CHANNELS=@jobs_channel_1,@jobs_channel_2
TELEGRAM_SOURCE_FETCH_LIMIT=80
TELEGRAM_VACANCY_BANNED_WORDS=врач,водитель,агент,терапевт,диспетчер
TELEGRAM_HOUSE_CHATS=Дом 1=@house_chat_1;Дом 2=@house_chat_2
MAX_CHARS_PER_HOUSE_CHAT_BATCH=3000

# Required only for enabled house chats; vacancies do not use an LLM
# GROQ_API_KEY / OPENAI_API_KEY and OPENAI_BASE_URL / OPENAI_MODEL also work
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
SUMMARY_MAX_OUTPUT_TOKENS=220

# Vacancies run daily at 10:00 UTC (13:00 Moscow), house chats run manually
TZ=Europe/Moscow
LOG_LEVEL=INFO
